# Port. Cloud Run sets this.
PORT=8080

# The project and database the main app uses.
GCP_PROJECT_ID="project-e090d449-585b-495d-8b9"
FIRESTORE_DATABASE_ID="ai-studio-compass-c30e6245-09d5-4235-8adc-d4c50e6ddca0"

# Requests per minute per uid. Defaults to 60.
MCP_RATE_LIMIT=60

# Credentials.
# On Cloud Run, leave both unset and let the service account supply Application
# Default Credentials.
# Locally, either point GOOGLE_APPLICATION_CREDENTIALS at a service account file, or
# put the whole JSON in GOOGLE_SERVICE_ACCOUNT_JSON.
# GOOGLE_APPLICATION_CREDENTIALS="./service-account.json"
# GOOGLE_SERVICE_ACCOUNT_JSON=""
