# GEMINI_API_KEY: required for every Gemini call.
# In production this is injected by Cloud Run from Google Cloud Secret Manager.
# It is read only on the server and never reaches the browser bundle.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: where the app is being served from.
APP_URL="http://localhost:3000"

# PORT: the server port. Cloud Run sets this for you.
PORT=3000

# NODE_ENV: leave this UNSET locally. The server treats anything other than
# "production" as development and mounts the Vite middleware.
# Do NOT set NODE_ENV="development" here: `npm run build` reads this file, and a
# development value produces a development JSX bundle that is larger and embeds
# absolute source paths. Cloud Run should set NODE_ENV=production.
# NODE_ENV="production"

# --- Optional -------------------------------------------------------------

# Vertex AI route, used ahead of the AI Studio ladder when both are configured.
# VERTEX_API_KEY=""
# GCP_PROJECT_ID=""
# GCP_LOCATION="us-central1"

# Forces the primary model to fail so the fallback ladder can be demonstrated.
# The same thing can be done per request with the x-test-force-503 header.
# COMPASS_FORCE_MODEL_FAILURE="true"
